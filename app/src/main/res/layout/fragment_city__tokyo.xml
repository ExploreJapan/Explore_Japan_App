<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:orientation="vertical">

    <!-- Шапка -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@color/grad3"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/top_line"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:scaleX="5"
            android:scaleY="1"
            android:src="@drawable/horizontal_line"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/zen_old_mincho"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:textSize="40sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Прокручиваемый контейнер для блоков статей -->
    <ScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="56dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="visible">


            <TextView
                android:id="@+id/city_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/fjord_one"
                android:text="@string/tokyo"
                android:textColor="@color/black2"
                android:textSize="32sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Блок 1: Проживання -->
            <androidx.cardview.widget.CardView
                android:id="@+id/article_living"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:visibility="visible"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overlay_border"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/article_living_title"
                        android:layout_width="290dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/zen_old_mincho"
                        android:text="@string/living"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/add"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/add" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Блок 2: Транспорт -->
            <androidx.cardview.widget.CardView
                android:id="@+id/article_transport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:visibility="visible"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overlay_border"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/article_transport_title"
                        android:layout_width="290dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/zen_old_mincho"
                        android:text="@string/transport"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/add2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/add" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Блок 3: Їжа -->
            <androidx.cardview.widget.CardView
                android:id="@+id/article_food"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:visibility="visible"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overlay_border"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/article_food_title"
                        android:layout_width="290dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/zen_old_mincho"
                        android:text="@string/food"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/add3"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/add" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Блок 4: Визначні пам’ятки -->
            <androidx.cardview.widget.CardView
                android:id="@+id/article_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:visibility="visible"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overlay_border"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/article_place_title"
                        android:layout_width="290dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/zen_old_mincho"
                        android:text="@string/place"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/add4"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/add" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Содержимое для статьи "Проживання" -->
            <LinearLayout
                android:id="@+id/content_living"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Заголовок статьи -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/living"
                            android:textAlignment="center"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <!-- Подраздел 1.1: Середні ціни на проживання -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/living_one"
                            android:textAlignment="center"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Первая треть текста -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/living_one_text_part1"
                            android:textSize="12sp" />

                        <!-- Средняя часть: текст слева, фото справа -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="horizontal">

                            <!-- Текст слева -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="@string/living_one_text_part2"
                                android:textAlignment="inherit"
                                android:textSize="12sp" />

                            <!-- Фото справа -->
                            <ImageView
                                android:layout_width="98dp"
                                android:layout_height="150dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:adjustViewBounds="true"
                                android:scaleType="centerCrop"
                                android:src="@drawable/tokyo_11" />
                        </LinearLayout>

                        <!-- Последняя треть текста -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-14dp"
                            android:text="@string/living_one_text_part3"
                            android:textSize="12sp" />

                        <!-- Подраздел 1.2: Рекомендовані райони для проживання -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="@string/living_two"
                            android:textAlignment="center"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Первая треть текста -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/living_two_text_part1"
                            android:textSize="12sp" />

                        <!-- Средняя часть: фото слева, текст справа -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="horizontal">

                            <!-- Фото слева -->
                            <ImageView
                                android:layout_width="98dp"
                                android:layout_height="150dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:adjustViewBounds="true"
                                android:scaleType="centerCrop"
                                android:src="@drawable/tokyo_12" />

                            <!-- Вторая треть текста справа -->
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/living_two_text_part2"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Последняя треть текста -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-14dp"
                            android:text="@string/living_two_text_part3"
                            android:textSize="12sp" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- Содержимое для статьи "Транспорт" -->
            <LinearLayout
                android:id="@+id/content_transport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_directions" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Токио имеет развитую систему метро, поездов JR и автобусов. Рекомендуется приобрести Suica или Pasmo карту..."
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Содержимое для статьи "Їжа" -->
            <LinearLayout
                android:id="@+id/content_food"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Попробуйте суши, рамен, темпуру и уличную еду в районах Асакуса и Гинза..."
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_my_calendar" />
            </LinearLayout>

            <!-- Содержимое для статьи "Визначні пам’ятки" -->
            <LinearLayout
                android:id="@+id/content_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="16dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_mapmode" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Посетите Токио Ски, Императорский дворец, храм Сэнсо-дзи и район Синдзюку..."
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_mapmode" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Оверлей -->
    <androidx.cardview.widget.CardView
        android:id="@+id/overlay_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/overlay_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/overlay_border"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Контейнер для динамического содержимого -->
            </LinearLayout>
        </LinearLayout>

        <!-- Кнопка возврата (слева сверху) -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/back_button" />
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>