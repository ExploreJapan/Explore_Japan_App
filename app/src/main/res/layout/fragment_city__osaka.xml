                            android:textAlignment="center"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Фото -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="220dp"
                            android:src="@drawable/osaka_3"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true" />

                        <!-- Текст -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/osaka_place_four_three_text"
                            android:textSize="16sp" />

                        <!-- Подраздел 4.4: Район Дотонборі   -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/osaka_place_four_four"
                            android:textAlignment="center"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Фото -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="220dp"
                            android:src="@drawable/osaka_4"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true" />

                        <!-- Текст -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/osaka_place_four_four_text"
                            android:textSize="16sp" />

                        <!-- Подраздел 4.5: Хмарочос Умеда   -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/osaka_place_four_five"
                            android:textAlignment="center"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Фото -->
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="220dp"
                            android:src="@drawable/osaka_5"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true" />

                        <!-- Текст -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/osaka_place_four_five_text"
                            android:textSize="16sp" />

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


    <!-- Оверлей -->
    <androidx.cardview.widget.CardView
        android:id="@+id/overlay_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/overlay_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/overlay_border"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Контейнер для динамического содержимого -->
            </LinearLayout>
        </LinearLayout>

        <!-- Кнопка возврата (слева сверху) -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/back_button" />
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>