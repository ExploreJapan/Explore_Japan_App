<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Шапка -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/lightred"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/top_line"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:scaleX="5"
            android:scaleY="1"
            android:src="@drawable/horizontal_line"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/flag_japan"
            android:layout_width="63dp"
            android:layout_height="42dp"
            android:layout_marginStart="15dp"
            android:contentDescription="@string/hint_flag"
            android:src="@drawable/japanflag"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fjord_one"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:textSize="34sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Контент -->
    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Кнопка "Повернутися назад" -->
            <Button
                android:id="@+id/back_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Повернутися назад"
                android:layout_marginBottom="16dp" />

            <!-- Перемикач між Вхід і Реєстрація -->
            <RadioGroup
                android:id="@+id/auth_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/login_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вхід"
                    android:checked="true"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/register_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Реєстрація"
                    android:textSize="18sp" />

            </RadioGroup>

            <!-- Поле для логіну (використовується в обох режимах) -->
            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Логін"
                android:inputType="text" />

            <!-- Поле для пошти (використовується тільки при реєстрації) -->
            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Пошта"
                android:inputType="textEmailAddress"
                android:visibility="gone" />

            <!-- Поле для пароля (використовується в обох режимах) -->
            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Пароль"
                android:inputType="textPassword" />

            <!-- Поле для підтвердження пароля (використовується тільки при реєстрації) -->
            <EditText
                android:id="@+id/confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Підтвердіть пароль"
                android:inputType="textPassword"
                android:visibility="gone" />

            <!-- Кнопка дії (залежить від режиму: "Увійти" або "Зареєструватися") -->
            <Button
                android:id="@+id/auth_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Увійти" />

            <!-- Повідомлення про результат -->
            <TextView
                android:id="@+id/auth_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- Підвал -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/lightred"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/info_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="290dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/cambo"
            android:text="@string/map"
            android:textColorLink="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/map_icon"
            app:layout_constraintStart_toStartOf="@+id/map_icon"
            app:layout_constraintTop_toTopOf="@+id/home_icon" />

        <ImageView
            android:id="@+id/tips_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="150dp"
            android:layout_marginBottom="14dp"
            android:src="@drawable/tips"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tips_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/cambo"
            android:text="@string/tips"
            android:textColorLink="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tips_icon"
            app:layout_constraintStart_toStartOf="@+id/tips_icon"
            app:layout_constraintTop_toTopOf="@+id/home_icon" />

        <ImageView
            android:id="@+id/bottom_line"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="72dp"
            android:scaleX="5"
            android:src="@drawable/horizontal_line"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/map_icon"
            android:layout_width="50dp"
            android:layout_height="46dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="300dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/map"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/options_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/cambo"
            android:text="@string/options"
            android:textColorLink="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/info_icon"
            app:layout_constraintStart_toStartOf="@+id/info_icon"
            app:layout_constraintTop_toTopOf="@+id/home_icon" />

        <ImageView
            android:id="@+id/sections_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="150dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/profile"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/profile_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/cambo"
            android:text="@string/profile"
            android:textColorLink="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/sections_icon"
            app:layout_constraintStart_toStartOf="@+id/sections_icon"
            app:layout_constraintTop_toTopOf="@+id/home_icon" />

        <ImageView
            android:id="@+id/home_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/home"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/home_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/cambo"
            android:text="@string/home"
            android:textColorLink="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/home_icon"
            app:layout_constraintStart_toStartOf="@+id/home_icon"
            app:layout_constraintTop_toTopOf="@+id/home_icon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>