<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="65dp"/>
            <solid android:color="#EFE5CA" />
            <stroke
                android:width="4dp"
            android:color="#A68A64" />
            <size
                android:width="30dp"
            android:height="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="30dp"
                android:height="30dp" />
        </shape>
    </item>
</selector>